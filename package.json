{
  "name": "blastyard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run validate:content",
    "test:e2e": "playwright test",
    "sim:bench": "node scripts/run-ts.mjs scripts/sim-bench.ts",
    "bot:league": "node scripts/run-ts.mjs scripts/bot-league.ts",
    "validate:content": "node scripts/run-ts.mjs scripts/validate-content.ts",
    "solve:challenges": "node scripts/run-ts.mjs scripts/solve-challenges.ts",
    "native:config": "node scripts/run-ts.mjs scripts/native-config.ts",
    "capacitor:sync:after": "npm run native:config",
    "assets": "node scripts/run-ts.mjs scripts/assets.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "pixi.js": "^8.22.0",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
